{
  "openapi": "3.0.3",
  "info": {
    "title": "Core Banking AI Agent Service API",
    "description": "Enterprise Core Banking API specification designed for Microsoft Copilot Studio Agent Actions and Generative Orchestration.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.banking.example.com",
      "description": "Production Gateway"
    },
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Development / Sandbox Mock Server"
    }
  ],
  "paths": {
    "/api/v1/customers/{customerId}/accounts": {
      "get": {
        "operationId": "getCustomerAccounts",
        "summary": "Get all accounts for a customer",
        "description": "Retrieves the list of active checking, savings, credit card, and loan accounts associated with the authenticated customer ID.",
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "description": "The unique banking customer ID (e.g., CUST-10029).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer accounts retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerAccountsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found"
          }
        }
      }
    },
    "/api/v1/accounts/{accountId}/balance": {
      "get": {
        "operationId": "getAccountBalance",
        "summary": "Get real-time balance for an account",
        "description": "Returns current available balance, ledger balance, currency, and account status for a given account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The unique account ID (e.g., ACC-CHECK-9812).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account balance returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountBalanceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/{accountId}/transactions": {
      "get": {
        "operationId": "getRecentTransactions",
        "summary": "Get recent account transactions",
        "description": "Fetches the last N transactions for an account with merchant name, amount, status, date, and category.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The account ID to query.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of transactions to return (default 5, max 20).",
            "schema": {
              "type": "integer",
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of recent transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cards/{cardId}/status": {
      "post": {
        "operationId": "updateCardStatus",
        "summary": "Freeze, unfreeze, or block a debit/credit card",
        "description": "Changes the operational state of a payment card. Used when customer reports lost, stolen, or temporarily misplaced card.",
        "parameters": [
          {
            "name": "cardId",
            "in": "path",
            "required": true,
            "description": "The unique card token identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCardStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Card status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/disputes/create": {
      "post": {
        "operationId": "createTransactionDispute",
        "summary": "Submit a dispute or chargeback claim for a transaction",
        "description": "Initiates a formal banking dispute case for an unrecognized or fraudulent transaction.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDisputeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dispute case filed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateDisputeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/otp/send": {
      "post": {
        "operationId": "sendStepUpOtp",
        "summary": "Send One-Time Passcode (OTP) for Step-up verification",
        "description": "Generates and sends an SMS/Push verification code to the customer's registered phone before high-risk operations.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customerId": { "type": "string" },
                  "actionType": { "type": "string", "example": "CARD_UNFREEZE" }
                },
                "required": ["customerId", "actionType"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP dispatched",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challengeId": { "type": "string" },
                    "maskedDestination": { "type": "string", "example": "+1 (***) ***-8812" },
                    "expiresInSeconds": { "type": "integer", "example": 300 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/otp/verify": {
      "post": {
        "operationId": "verifyStepUpOtp",
        "summary": "Validate One-Time Passcode (OTP)",
        "description": "Validates the user-submitted 6-digit code against the active challenge.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "challengeId": { "type": "string" },
                  "otpCode": { "type": "string", "example": "489201" }
                },
                "required": ["challengeId", "otpCode"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification outcome",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "verified": { "type": "boolean" },
                    "verificationToken": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CustomerAccountsResponse": {
        "type": "object",
        "properties": {
          "customerId": { "type": "string" },
          "customerName": { "type": "string" },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accountId": { "type": "string" },
                "accountType": { "type": "string", "enum": ["CHECKING", "SAVINGS", "CREDIT_CARD", "MORTGAGE"] },
                "accountNumberMasked": { "type": "string", "example": "******3912" },
                "currency": { "type": "string", "example": "USD" },
                "availableBalance": { "type": "number", "example": 4520.50 },
                "status": { "type": "string", "example": "ACTIVE" }
              }
            }
          }
        }
      },
      "AccountBalanceResponse": {
        "type": "object",
        "properties": {
          "accountId": { "type": "string" },
          "accountType": { "type": "string" },
          "accountNumberMasked": { "type": "string", "example": "******3912" },
          "currency": { "type": "string", "example": "USD" },
          "availableBalance": { "type": "number", "example": 4520.50 },
          "currentLedgerBalance": { "type": "number", "example": 4600.00 },
          "lastUpdated": { "type": "string", "format": "date-time" }
        }
      },
      "TransactionsResponse": {
        "type": "object",
        "properties": {
          "accountId": { "type": "string" },
          "transactions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "transactionId": { "type": "string" },
                "postedDate": { "type": "string", "format": "date" },
                "merchant": { "type": "string" },
                "category": { "type": "string" },
                "amount": { "type": "number" },
                "currency": { "type": "string" },
                "status": { "type": "string", "enum": ["POSTED", "PENDING", "DISPUTED"] }
              }
            }
          }
        }
      },
      "UpdateCardStatusRequest": {
        "type": "object",
        "properties": {
          "newStatus": {
            "type": "string",
            "enum": ["FROZEN", "ACTIVE", "PERMANENTLY_BLOCKED"],
            "description": "FROZEN = temporary lock, ACTIVE = normal, PERMANENTLY_BLOCKED = card stolen/reissue needed"
          },
          "reason": { "type": "string", "example": "User misplaced card at coffee shop" },
          "verificationToken": { "type": "string", "description": "Required if unfreezing or blocking" }
        },
        "required": ["newStatus", "reason"]
      },
      "CardStatusResponse": {
        "type": "object",
        "properties": {
          "cardId": { "type": "string" },
          "cardMasked": { "type": "string", "example": "Visa ending in 9102" },
          "status": { "type": "string", "example": "FROZEN" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "confirmationCode": { "type": "string", "example": "FRZ-8921-X" }
        }
      },
      "CreateDisputeRequest": {
        "type": "object",
        "properties": {
          "customerId": { "type": "string" },
          "accountId": { "type": "string" },
          "transactionId": { "type": "string" },
          "disputeReason": {
            "type": "string",
            "enum": ["UNRECOGNIZED_MERCHANT", "INCORRECT_AMOUNT", "DUPLICATE_CHARGE", "GOODS_NOT_RECEIVED", "FRAUDULENT"]
          },
          "customerRemarks": { "type": "string" }
        },
        "required": ["customerId", "accountId", "transactionId", "disputeReason"]
      },
      "CreateDisputeResponse": {
        "type": "object",
        "properties": {
          "disputeCaseId": { "type": "string", "example": "DSP-2026-98124" },
          "status": { "type": "string", "example": "UNDER_REVIEW" },
          "provisionalCreditEligible": { "type": "boolean", "example": true },
          "estimatedResolutionDays": { "type": "integer", "example": 10 },
          "message": { "type": "string", "example": "Dispute case filed. A temporary credit may be applied within 48 hours." }
        }
      }
    }
  }
}
