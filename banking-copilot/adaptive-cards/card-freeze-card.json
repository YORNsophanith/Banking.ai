{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "warning",
      "items": [
        {
          "type": "TextBlock",
          "text": "🔒 Card Security Status Update",
          "weight": "Bolder",
          "size": "Large"
        },
        {
          "type": "TextBlock",
          "text": "Your card ${cardMasked} has been set to: **${status}**",
          "wrap": true
        }
      ]
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Reference Code:", "value": "${confirmationCode}" },
        { "title": "Timestamp:", "value": "${updatedAt}" },
        { "title": "Impact:", "value": "All recurring and point-of-sale authorizations are temporarily blocked." }
      ]
    },
    {
      "type": "TextBlock",
      "text": "If you find your card, you can unfreeze it instantly below or by calling 24/7 Priority Support.",
      "isSubtle": true,
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Unfreeze Card (Requires OTP)",
      "data": {
        "action": "TRIGGER_UNFREEZE",
        "cardId": "${cardId}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Order Replacement Card",
      "data": {
        "action": "ORDER_REPLACEMENT",
        "cardId": "${cardId}"
      }
    }
  ]
}
